# Flask Secret Key
SECRET_KEY=smartroute-ai-secret-key-change-in-production

# External AI (Groq LPU)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# External Weather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here

# Email OTP Service (Resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=SmartRoute AI <onboarding@resend.dev>

# Fallback Local Database
DATABASE_PATH=database/smartroute.db
